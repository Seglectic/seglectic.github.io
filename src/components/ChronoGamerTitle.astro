---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<h1 class:list={['chrono-title', className]}>
  chrono<span class="accent">Gamer</span>
</h1>

<style>
  .chrono-title {
    font-family: 'ChronoType', "Segoe UI", "Aptos", "Helvetica Neue", "Arial Nova", sans-serif;
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 400;
    color: #fbfbf7;
    margin: 0;
    letter-spacing: 0;
    line-height: 0.92;
    text-wrap: balance;
    text-shadow: 0 0 24px rgba(15, 15, 15, 0.28);
  }

  .chrono-title .accent {
    color: var(--accent);
  }
</style>
