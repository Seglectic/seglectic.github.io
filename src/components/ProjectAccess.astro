---
interface Props {
  live: string;
}

const { live } = Astro.props;
---

{live && (
  <div class="project-access">
    <a href={live} class="access-btn" target="_blank" rel="noopener noreferrer">
      View Live
    </a>
  </div>
)}

<style>
  .project-access {
    margin: var(--space-lg) 0;
    text-align: center;
  }

  .access-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 2px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(212, 83, 26, 0.08);
    backdrop-filter: blur(12px);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.18, 0.82, 0.22, 1);
    box-shadow: 0 0 0 rgba(212, 83, 26, 0.4);
    animation: pulse 2.5s ease-in-out infinite;
  }

  .access-btn:hover {
    border-color: #ff6b35;
    color: #ff6b35;
    background: rgba(212, 83, 26, 0.2);
    transform: scale(1.08);
    box-shadow: 0 0 20px rgba(212, 83, 26, 0.6), 0 4px 16px rgba(0, 0, 0, 0.3);
    animation: none;
  }

  .access-btn:active {
    transform: scale(1.04);
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(212, 83, 26, 0.4);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(212, 83, 26, 0);
    }
  }
</style>
