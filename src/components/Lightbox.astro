---
import IconX from '~icons/tabler/x';
---

<div class="lightbox" data-lightbox hidden>
  <div class="lightbox-backdrop" data-lightbox-backdrop></div>
  <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Expanded image view">
    <button class="lightbox-close" type="button" aria-label="Close image viewer" data-lightbox-close>
      <IconX />
    </button>
    <img class="lightbox-image" alt="" data-lightbox-image />
  </div>
</div>

<style>
  :global([data-lightboxable]) {
    cursor: zoom-in;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 4, 6, 0.82);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 240ms ease-out;
  }

  .lightbox.is-open .lightbox-backdrop {
    opacity: 1;
  }

  .lightbox-dialog {
    position: relative;
    z-index: 1;
    max-width: min(92vw, 1400px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: calc(90vh - 2rem - var(--space-sm));
    width: auto;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
    background: rgba(10, 10, 12, 0.96);
    transform-origin: center center;
    will-change: transform;
  }

  .lightbox-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(232, 232, 230, 0.22);
    background: rgba(15, 15, 15, 0.6);
    color: var(--text-muted);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .lightbox-close :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .lightbox-close:hover {
    color: var(--text);
    border-color: rgba(232, 232, 230, 0.5);
  }
</style>

<script>
  const initLightbox = () => {
    const lightbox = document.querySelector('[data-lightbox]');
    const lightboxImage = document.querySelector('[data-lightbox-image]');
    const backdrop = document.querySelector('[data-lightbox-backdrop]');
    const closeButton = document.querySelector('[data-lightbox-close]');

    if (!lightbox || !lightboxImage || !backdrop || !closeButton) return;
    if (lightbox.dataset.bound === 'true') return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let sourceImage = null;
    let closeAnimation = null;

    const flip = (from, to) => {
      const scaleX = from.width / to.width;
      const scaleY = from.height / to.height;
      const tx = (from.left + from.width / 2) - (to.left + to.width / 2);
      const ty = (from.top + from.height / 2) - (to.top + to.height / 2);
      return { scaleX, scaleY, tx, ty };
    };

    const showCloseButton = () => {
      closeButton.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: 180, easing: 'ease-out', fill: 'forwards' }
      );
    };

    const hideCloseButton = () => {
      closeButton.getAnimations().forEach(a => a.cancel());
      closeButton.style.opacity = '0';
    };

    const openLightbox = (trigger) => {
      const src = trigger.getAttribute('src');
      if (!src) return;

      if (closeAnimation) {
        closeAnimation.cancel();
        closeAnimation = null;
      }

      sourceImage = trigger;
      const sourceRect = trigger.getBoundingClientRect();

      lightboxImage.src = src;
      lightboxImage.alt = trigger.getAttribute('alt') ?? '';
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        lightbox.classList.add('is-open');

        if (reduced) {
          showCloseButton();
          return;
        }

        const targetRect = lightboxImage.getBoundingClientRect();
        const { scaleX, scaleY, tx, ty } = flip(sourceRect, targetRect);

        const anim = lightboxImage.animate(
          [
            { transform: `translate(${tx}px, ${ty}px) scale(${scaleX}, ${scaleY})`, opacity: 0.6 },
            { transform: 'translate(0, 0) scale(1)', opacity: 1 },
          ],
          { duration: 400, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' }
        );

        anim.onfinish = showCloseButton;
      });
    };

    const closeLightbox = () => {
      hideCloseButton();

      if (reduced || !sourceImage) {
        lightbox.classList.remove('is-open');
        lightbox.hidden = true;
        lightboxImage.removeAttribute('src');
        lightboxImage.alt = '';
        sourceImage = null;
        document.body.style.removeProperty('overflow');
        return;
      }

      const targetRect = lightboxImage.getBoundingClientRect();
      const sourceRect = sourceImage.getBoundingClientRect();
      const { scaleX, scaleY, tx, ty } = flip(sourceRect, targetRect);

      lightbox.classList.remove('is-open');

      closeAnimation = lightboxImage.animate(
        [
          { transform: 'translate(0, 0) scale(1)', opacity: 1 },
          { transform: `translate(${tx}px, ${ty}px) scale(${scaleX}, ${scaleY})`, opacity: 0 },
        ],
        { duration: 160, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
      );

      closeAnimation.onfinish = () => {
        lightbox.hidden = true;
        lightboxImage.removeAttribute('src');
        lightboxImage.alt = '';
        sourceImage = null;
        closeAnimation = null;
        document.body.style.removeProperty('overflow');
        lightboxImage.getAnimations().forEach(a => a.cancel());
      };
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-lightboxable]');
      if (trigger instanceof HTMLImageElement) {
        openLightbox(trigger);
        return;
      }
      if (
        event.target === backdrop ||
        event.target === closeButton ||
        event.target.closest('[data-lightbox-close]')
      ) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });

    lightbox.dataset.bound = 'true';
  };

  initLightbox();

  if (!window.__seglecticLightboxBound) {
    document.addEventListener('astro:page-load', initLightbox);
    window.__seglecticLightboxBound = true;
  }
</script>
