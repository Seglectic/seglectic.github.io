---
import IconGithub from '~icons/simple-icons/github';
import IconBluesky from '~icons/simple-icons/bluesky';
---

<footer>
  <div class="footer-inner">
    <a
      href="https://bsky.app/profile/seglectic.com"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
      aria-label="Seglectic on Bluesky"
    >
      <IconBluesky class="footer-icon" aria-hidden="true" />
    </a>
    <a
      href="https://github.com/Seglectic"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
      aria-label="Seglectic on GitHub"
    >
      <IconGithub class="footer-icon" aria-hidden="true" />
    </a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-xl);
  }

  .footer-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0.7rem 1.1rem 0.8rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-md);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .footer-inner {
      padding: 0.7rem 0.9rem 0.8rem;
    }
  }
</style>
